{
  "include": [
    "node_modules/bc-stubs/bc/**/*.d.ts",
    "**/*.js",
    "**/*.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
		"esModuleInterop": true,
    "allowJs": false,
    "removeComments": true,
    "sourceMap": true,
    "skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"noEmit": true,
    "strict": true,
    "experimentalDecorators": true,
    "paths": {
      "src/*": ["./src/*"],
      "dto/*": ["./src/dto/*"],
      "images/*": ["./src/images/*"],
      "modules/*": ["./src/modules/*"],
      "subscreens/*": ["./src/subscreens/*"],
      "types/*": ["./src/types/*"],
    }
  },
}